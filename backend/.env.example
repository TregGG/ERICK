# Copy to backend/.env and adjust. All values here are placeholders.
APP_ENV=development                # development | test | production
HOST=127.0.0.1
PORT=8091

# PostgreSQL + PostGIS (docker compose up -d database). SQLite works for quick runs without Docker:
#   DATABASE_URL=sqlite+aiosqlite:///backend/erick_dev.db
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:55432/erickshaw

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRY_HOURS=24

OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=6
OTP_REQUESTS_PER_IP_PER_10_MIN=10
# Development only: return/show the OTP instead of sending SMS. Must be false in production.
# (Has no effect with twilio_verify: the code then exists only at Twilio.)
OTP_DEV_MODE=true
# console (development, no SMS) | twilio_verify (recommended for India) | twilio (plain SMS; India needs DLT registration)
SMS_PROVIDER=console
# From https://console.twilio.com (Account Info). Keep these out of git.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# twilio_verify: Verify > Services > your service (starts with VA)
TWILIO_VERIFY_SERVICE_SID=
# twilio (plain SMS) only: your Twilio sender number
TWILIO_FROM_NUMBER=

# JSON list of allowed browser origins when the frontend is served from another host, e.g. ["https://rick.example.edu"]
CORS_ORIGINS=[]

# OSRM-compatible routing server. The public demo server is rate limited (~1 req/s) and not for production.
# Leave empty to disable network routing (distances are then labelled as straight-line approximations).
ROUTING_BASE_URL=https://router.project-osrm.org
ROUTING_PROFILE=driving
ERICKSHAW_AVG_SPEED_KMH=15

LOCATION_MAX_ACCURACY_METERS=100
LOCATION_MAX_AGE_SECONDS=120
LOCATION_MIN_INTERVAL_SECONDS=1
GEOFENCE_BUFFER_METERS=150
# Development only: allows the clearly labelled driver location simulator.
SIMULATION_ENABLED=false

DISPATCH_ENABLED=true
DISPATCH_TICK_SECONDS=1
